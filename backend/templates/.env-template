DB_HOST=mariadb
DB_PORT=3306
DB_USER=ootp
DB_PASSWORD=supersecretpw
DB_NAME=ootp

# leave unset (or any value other than "production") for local dev, which
# runs DevConfig (DEBUG=True). Set to "production" to run ProdConfig instead.
APP_ENV=development

# profile identification
GAME_PATH=Path to the local game dump directory
DUMP_PATH=/data/dumps

# required to call /api/admin/* routes (send as the X-Admin-Token header).
# generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_TOKEN=
