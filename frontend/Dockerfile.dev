FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install only production dependencies initially for better caching
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy rest of the source files
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Enable hot reloading by ensuring proper host binding
ENV HOST=0.0.0.0

# Start Vite development server
CMD ["npm", "run", "dev"]

